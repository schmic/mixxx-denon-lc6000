<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset schemaVersion="1" mixxxVersion="2.5">
    <info>
        <name>Denon LC6000 Prime Deck 4</name>
        <author>schmic</author>
        <description>Mixxx mapping for the Denon LC6000 Prime fixed to Deck 4, with transport, browse, jog, pitch, LEDs, center-display control, Hot Cue, Roll, and inferred Auto Loop pads.</description>
    </info>
    <settings>
        <option variable="deckNumber" type="integer" min="4" max="4" default="4" label="Fixed controlled deck">
            <description>This preset is fixed to Mixxx Deck 4.</description>
        </option>
        <option variable="screenBrightness" type="enum" label="Center display brightness">
            <value>Low</value>
            <value>Mid</value>
            <value default="true">High</value>
            <value>Max</value>
            <description>Brightness value sent to the reconstructed LC6000 display SysEx path.</description>
        </option>
        <option variable="jogSensitivity" type="real" min="0.1" max="10.0" default="1.0" label="Jog sensitivity">
            <description>Sensitivity factor for jog ticks when the platter is not scratching.</description>
        </option>
        <option variable="vinylModeOn" type="boolean" default="true" label="Start in vinyl mode">
            <description>Whether the platter touch surface should enable scratching on startup.</description>
        </option>
        <option variable="enableDisplay" type="boolean" default="true" label="Enable center display SysEx">
            <description>Disable this if you only want the standard MIDI mapping without the reconstructed display path.</description>
        </option>
    </settings>
